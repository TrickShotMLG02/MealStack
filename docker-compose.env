# ===============================
# MySQL container settings
# ===============================

MYSQL_DATABASE=mealstack
MYSQL_USER=mealstack
MYSQL_PASSWORD=mealstack
MYSQL_ROOT_PASSWORD=mealstack-root

# ===============================
# Application env file overrides
# ===============================

DB_ENGINE=mysql
DB_NAME_MYSQL="${MYSQL_DATABASE}"
DB_USER="${MYSQL_USER}"
DB_PASSWORD="${MYSQL_PASSWORD}"
DB_HOST=db
DB_PORT=3306
